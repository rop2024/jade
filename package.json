{
  "name": "electron-react-starter",
  "version": "1.0.0",
  "description": "Reusable Electron + React + SQLite (sql.js) desktop app starter template",
  "main": "electron/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "cross-env NODE_ENV=development wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:react && npm run build:electron",
    "build:react": "vite build",
    "build:electron": "electron-builder",
    "dist": "npm run build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "build": {
    "appId": "com.starter.app",
    "productName": "Electron React Starter",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "database/**/*",
      "api/**/*",
      "sync/**/*",
      "storage/**/*",
      "!node_modules/.bin",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron-settings": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.20.0",
    "sql.js": "^1.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron": "^27.3.11",
    "electron-builder": "^24.6.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "vite": "^4.5.0",
    "wait-on": "^7.0.0"
  }
}
