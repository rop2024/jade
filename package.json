{
  "name": "jade",
  "version": "1.0.0",
  "description": "Jade — AI-powered desktop assistant for your Obsidian vault and local models",
  "main": "electron/main/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dev": "cross-env NODE_ENV=development concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "cross-env NODE_ENV=development wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:react && npm run build:electron",
    "build:react": "vite build",
    "build:electron": "electron-builder",
    "dist": "npm run build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "build": {
    "appId": "com.jade.app",
    "productName": "Jade",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "database/**/*",
      "api/**/*",
      "sync/**/*",
      "storage/**/*",
      "resources/**/*",
      "!node_modules/.bin",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "electron/main/main.js"
    },
    "win": {
      "target": "nsis",
      "extraMetadata": {
        "main": "electron/main/main.js"
      }
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "asar": {
      "unpackDir": "node_modules/better-sqlite3"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "axios": "^1.6.0",
    "better-sqlite3": "^13.0.3",
    "electron-settings": "^4.0.0",
    "gray-matter": "^4.0.3",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "sql.js": "^1.8.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "vite": "^8.3.6",
    "wait-on": "^7.0.0"
  }
}
